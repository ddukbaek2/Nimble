<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Nimble.Host.SDL</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup><!-- <ProjectReference Include="..\Nimble.Core\Nimble.Core.csproj" /> -->
    <!-- UI가 필요하면 아래 줄 주석 해제 -->
    <!-- <ProjectReference Include="..\Nimble.UI\Nimble.UI.csproj" /> -->
  
    <Folder Include="src\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.MacOS" Version="2.88.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.6" />
  </ItemGroup>

  <!-- SDL2 네이티브 복사: 프로젝트 루트의 native/<rid> 배치 -->
  <ItemGroup Condition="'$(RuntimeIdentifier)'=='win-x64'">
    <None Include="native/win-x64/SDL2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)'=='osx-x64'">
    <None Include="native/osx-x64/libSDL2.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)'=='osx-arm64'">
    <None Include="native/osx-arm64/libSDL2.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)'=='linux-x64'">
    <None Include="native/linux-x64/libSDL2-2.0.so.0" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>